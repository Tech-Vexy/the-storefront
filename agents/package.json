{
  "name": "agents",
  "version": "1.0.0",
  "description": "Storefront Swarm Agents",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently -n \"manager,buyer\" -c \"blue,yellow\" \"pnpm start:manager\" \"pnpm start:buyer\"",
    "dev:full": "concurrently -n \"manager,buyer,supplier,restocker\" -c \"blue,yellow,green,magenta\" \"pnpm start:manager\" \"pnpm start:buyer\" \"pnpm start:supplier\" \"pnpm start:restock\"",
    "start:buyer": "tsx kiteBuyer.ts",
    "start:manager": "tsx storeManager.ts",
    "start:supplier": "tsx supplierAgent.ts",
    "start:restock": "tsx restockAgent.ts"
  },
  "dependencies": {
    "@coinbase/coinbase-sdk": "^0.25.0",
    "@langchain/core": "^1.1.41",
    "@langchain/groq": "^1.2.0",
    "@langchain/langgraph": "^1.2.9",
    "@sanity/client": "^6.15.0",
    "axios": "^1.15.2",
    "dotenv": "^16.4.5",
    "ethers": "^6.11.1",
    "express": "^4.19.2",
    "gokite-aa-sdk": "^1.0.15",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.7",
    "concurrently": "^9.2.1",
    "tsx": "^4.7.2",
    "typescript": "^5.4.5"
  }
}
