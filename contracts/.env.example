# ── Kite AI Testnet ──────────────────────────────────────────────────────────
# Chain ID: 2368 | Explorer: https://testnet.kitescan.ai/
# Faucet: https://faucet.gokite.ai
KITE_RPC_URL=https://rpc-testnet.gokite.ai/
# Deployer wallet private key (with 0x prefix)
KITE_PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE
# Etherscan-compatible API key from https://testnet.kitescan.ai/
KITE_EXPLORER_API_KEY=YOUR_KITESCAN_API_KEY_HERE

# ── Storefront deploy (scripts/deploy-storefront.ts) ─────────────────────────
# Human label hashed via keccak256 and committed on-chain as storePolicyHash.
STORE_POLICY_LABEL=kite-storefront/v1
# Optional: IPFS CID of the canonical policy doc (recorded in deployments.json).
# STORE_POLICY_CID=bafy...
# Optional: treasury address for settlement payouts. Defaults to the deployer.
# TREASURY_ADDRESS=0x...
# Optional: passports auto-authenticated after deploy.
# KITE_PASSPORT_ID=agp_...
# SUPPLIER_PASSPORT_ID=agp_...
# TREASURY_PASSPORT_ID=agp_...

# ── AgentTreasury deploy (scripts/deploy-treasury.ts) ────────────────────────
# Optional: governance EOA/multisig. Defaults to the deployer.
# GOVERNANCE_ADDRESS=0x...
# Optional: minimum stake per agent in wei. Defaults to 0.01 KITE (1e16).
# MIN_AGENT_STAKE_WEI=10000000000000000
# Optional: override the attestation address read from deployments/<network>.json.
# ATTESTATION_ADDRESS=0x...
